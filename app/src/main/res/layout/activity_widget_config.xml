<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F2EE"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="設計我的計算機"
            android:textColor="@color/text_main"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="換字、換圖、換機色。每一顆 Widget 可以不一樣。"
            android:textColor="#81736B"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp">

            <ImageView
                android:id="@+id/previewBody"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_label"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/previewTitle1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="胖錢包"
                            android:textColor="@color/text_main"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/previewTitle2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="計算機"
                            android:textColor="@color/text_main"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/previewHeart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="♥"
                            android:textColor="#E95863"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/previewMascot"
                        android:layout_width="120dp"
                        android:layout_height="100dp"
                        android:contentDescription="預覽圖片"
                        android:scaleType="centerInside"
                        android:src="@drawable/mingpang_default" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_display"
                    android:gravity="center_vertical|end"
                    android:paddingEnd="14dp"
                    android:text="12,580"
                    android:textColor="@color/text_main"
                    android:textSize="34sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="文字（每行建議 1～8 字）"
            android:textColor="@color/text_main"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTitle1"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="第一行，例如：胖錢包"
            android:inputType="text"
            android:maxLength="8"
            android:singleLine="true"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/editTitle2"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="第二行，例如：計算機"
            android:inputType="text"
            android:maxLength="8"
            android:singleLine="true"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="字級"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerFontSize"
            android:layout_width="match_parent"
            android:layout_height="52dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="愛心"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerHeart"
            android:layout_width="match_parent"
            android:layout_height="52dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="機身顏色"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerTheme"
            android:layout_width="match_parent"
            android:layout_height="52dp" />

        <EditText
            android:id="@+id/editHexColor"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="#F6E29A"
            android:inputType="textCapCharacters"
            android:maxLength="9"
            android:singleLine="true"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="圖片"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnImageDefault1"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="小小胖｜正面" />

        <Button
            android:id="@+id/btnImageDefault2"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:text="小小胖｜揮手" />

        <Button
            android:id="@+id/btnImageCustom"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:text="從手機相簿選圖片" />

        <Button
            android:id="@+id/btnImageNone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:text="不顯示圖片" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:text="恢復 v2 原廠胖錢包" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_button_pink"
            android:text="完成・放到桌面"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
