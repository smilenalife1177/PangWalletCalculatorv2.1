<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widgetBodyBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="7dp">

        <LinearLayout
            android:id="@+id/widgetHeader"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/titlePanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_label"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView android:id="@+id/titleLine1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:text="胖錢包" android:textColor="@color/text_main" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/titleLine2" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:text="計算機" android:textColor="@color/text_main" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/btnEditStyle" android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center" android:text="♥" android:textColor="#E95863" android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/mascot"
                android:layout_width="78dp"
                android:layout_height="72dp"
                android:contentDescription="我的圖片"
                android:scaleType="centerInside"
                android:src="@drawable/mingpang_default" />
        </LinearLayout>

        <TextView
            android:id="@+id/display"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_display"
            android:gravity="center_vertical|end"
            android:maxLines="1"
            android:paddingEnd="8dp"
            android:text="0"
            android:textColor="@color/text_main"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="3dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="7" android:textColor="@color/text_main" android:textSize="18sp" />
                <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="8" android:textColor="@color/text_main" android:textSize="18sp" />
                <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="9" android:textColor="@color/text_main" android:textSize="18sp" />
                <Button android:id="@+id/btnDivide" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_blue" android:text="÷" android:textColor="@color/white" android:textSize="18sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="4" android:textColor="@color/text_main" android:textSize="18sp" />
                <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="5" android:textColor="@color/text_main" android:textSize="18sp" />
                <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="6" android:textColor="@color/text_main" android:textSize="18sp" />
                <Button android:id="@+id/btnMultiply" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_blue" android:text="×" android:textColor="@color/white" android:textSize="18sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="1" android:textColor="@color/text_main" android:textSize="18sp" />
                <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="2" android:textColor="@color/text_main" android:textSize="18sp" />
                <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="3" android:textColor="@color/text_main" android:textSize="18sp" />
                <Button android:id="@+id/btnMinus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_blue" android:text="−" android:textColor="@color/white" android:textSize="18sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="0" android:textColor="@color/text_main" android:textSize="18sp" />
                <Button android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="." android:textColor="@color/text_main" android:textSize="18sp" />
                <Button android:id="@+id/btnPlus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_blue" android:text="+" android:textColor="@color/white" android:textSize="18sp" />
                <Button android:id="@+id/btnEquals" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_pink" android:text="=" android:textColor="@color/white" android:textSize="18sp" />
            </LinearLayout>
            <Button android:id="@+id/btnClear" android:layout_width="match_parent" android:layout_height="34dp" android:layout_margin="1dp" android:background="@drawable/bg_button_clear" android:text="C 清除" android:textColor="@color/text_main" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
